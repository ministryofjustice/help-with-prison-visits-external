{
  "name": "help-with-prison-visits-external",
  "version": "1.0.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ministryofjustice/help-with-prison-visits-external.git"
  },
  "engines": {
    "node": "^26",
    "npm": "^12"
  },
  "scripts": {
    "build": "./build",
    "css-build": "sass --no-source-map --quiet-deps --load-path=node_modules/govuk-frontend/dist --load-path=. ./app/assets/sass/application.scss ./app/public/stylesheets/application.css",
    "security_audit": "npx audit-ci --config audit-ci.json",
    "start": "node $NODE_OPTIONS ./app/bin/www | bunyan -o short",
    "start:dev": "npm run css-build && node --env-file=.env ./app/bin/www",
    "lint": "eslint . --cache --max-warnings 0",
    "lint-fix": "eslint . --fix",
    "test": "npm run lint && npm run test-unit",
    "test-integration": "KNEX_CONFIG=testing mocha --recursive test/integration/ --timeout 15000 --exit",
    "test-load": "cd test/load && ../../node_modules/.bin/artillery run scenarios.yaml cd ../../",
    "test-unit": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:ci": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --coverage",
    "test-e2e": "KNEX_CONFIG=testing cypress run --config video=false",
    "test-e2e-ui": "KNEX_CONFIG=testing cypress open",
    "prepare": "hmpps-precommit-hooks-prepare"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@ministryofjustice/hmpps-monitoring": "2.1.0",
    "applicationinsights": "^2.9.8",
    "bases": "^0.2.1",
    "bunyan": "^1.8.15",
    "bunyan-format": "^0.2.1",
    "clamscan": "^2.4.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cookie-session": "^2.1.1",
    "csrf-csrf": "^4.0.3",
    "debug": "^4.4.3",
    "express": "^5.3.0",
    "govuk-frontend": "6.6.0",
    "helmet": "^8.3.0",
    "i18n": "^0.15.4",
    "jquery": "^4.0.0",
    "jquery-ui": "^1.14.2",
    "knex": "^3.3.0",
    "moment": "^2.31.0",
    "multer": "^2.5.0",
    "nunjucks": "^3.2.4",
    "sanitize-html": "2.18.1",
    "tedious": "^20.3.8",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@ministryofjustice/eslint-config-hmpps": "^1.0.4",
    "@ministryofjustice/hmpps-precommit-hooks": "3.0.2",
    "cypress": "^16.2.1",
    "jest": "^30.5.2",
    "jest-html-reporter": "^4.4.2",
    "jest-junit": "^17.0.0",
    "lint-staged": "17.6.0",
    "node-mocks-http": "^1.18.1",
    "prettier": "^3.9.10",
    "sass": "^1.107.1",
    "supertest": "^7.3.1"
  },
  "overrides": {
    "@opentelemetry/core": "2.12.0",
    "brace-expansion": "5.0.12",
    "js-yaml": "5.5.0",
    "qs": "6.17.1"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "cypress@16.2.1": true,
    "dtrace-provider@0.8.8": false,
    "unrs-resolver@1.12.2": true
  }
}
